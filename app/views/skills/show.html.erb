<div class="container">
  <div class="row">
        <%= render 'skills/list', user: @user, book: @book%>
      <div class="col-md-8 offset-md-1">
        <h2>スキル詳細</h2>
        <strong>タイトル:</strong><%= @skill_show.title %>
        <br/>
        <strong>本文:</strong><%= @skill_show.body %>
        <br/>

        <h2>コメント一覧</h2>
        <% @comments.each do |c| %>
          <div>
          <a href="/users/<%= c.user.id %>"><%= c.user.email %></a>
          <%= c.content %>
          <hr>
          </div>
        <% end %>

        <%= form_for [@skill_show, @comment] do |f| %>
          <%= f.text_field :content %>
          <br>
          <%= f.submit 'コメントする' %>
        <% end %>

        <%= link_to "Edit", edit_skill_path %> | <a href="/skills">Back</a>
      </div>
    </div>
</div>