<div class="container px-5 px-sm-0">
  <%= flash[:notice] %>
  <% if @skill.errors.any? %>
    <%= @skill.errors.count %> errors prohibited this obj from being saved:
    <ul>
      <% @skill.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="row">
    <%= render 'skills/list', user: @user, skill: @skill %>
    <div class="col-md-8 offset-md-1">

    </br>
    <% if user_signed_in? %>
  <%= form_with url: search_path, method: :get, local: true do %>
    <%= text_field_tag :query, params[:query], placeholder: "検索ワードを入力" %>
    
    <%= select_tag :model, options_for_select([["User", "user"], ["Skill", "skill"]]), prompt: "検索対象を選択" %>
    
    <%= select_tag :search_method, options_for_select([["完全一致", "perfect"], ["前方一致", "forward"], ["後方一致", "backward"], ["部分一致", "partial"]]), prompt: "検索方法を選択" %>
    
    <%= submit_tag "検索" %>
  <% end %>
  </br>
<% end %>
      <h2>Skills</h2>
      <table class="table table-hover table-inverse">
        <thead>
          <tr>
            <th>名前</th>
            <th>タイトル</th>
            <th>本文</th>
            <th colspan="3"></th>
          </tr>
        </thead>
        <tbody> 
          <% @skills.each do |skill| %>
            <tr>
            <td><%= link_to user_path(skill.user) do %>
              <%= @user.name %><br/>
            <% end %>
              <td><%= link_to skill_path(skill.id) do %>
                    <%= skill.title %>
                  <% end %>
                </td>
              <td><%= skill.body %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>