<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm0 mx-auto">
      <h1>投稿内容の編集</h1>
      <%= form_for @skill do |f| %>
        <%= f.label :title %><br/>
        <%= f.text_field :title %>
        <br/><br/>
        <%= f.label :body %><br/>
        <%= f.text_area :body %>
        <br/>
        <%= f.submit '更新' %>
      <% end %>
      <%= link_to "Show", skill_path(@skill.id) %> | <%= link_to "Back", skills_path %>
    </div>
  </div>
</div>