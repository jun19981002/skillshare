<div class="container px-5 px-sm-0">
  <div>
    <%= flash[:notice] %>
  </div>
    <div class="row">
      <%= render 'users/list', user: @user, skill: @skill%>
      <div class="col-md-8 offset-md-1">
        <h2>Skills</h2>
        <table class="table table-hover table-inverse">
          <thead>
            <tr>
              <th></th>
              <th>タイトル</th>
              <th>本文</th>
              <th colspan="3"></th>
            </tr>
          </thead>
          <tbody> 
            <% @skills.each do |Skill| %>
              <tr>
                <td><%= link_to skill_path(skill.id) do %>
                      <%= skill.title %>
                    <% end %>
                  </td>
                <td><%= skill.body %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>