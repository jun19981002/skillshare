<div class="col-md-3">
<h2>User info</h2>
<table class="table">
  <tbody>
    <tr>
      <th>name</th> <th><%= user.name %></th>
    </tr>
  </tbody>
</table>

<div class="row">
  <%= link_to edit_user_path(user), class: 'btn btn-outline-secondary btn-block' do %>
    <i class="fa-solid fa-user-gear"></i>
  <% end %>
</div>

<h2 class="mt-3">Skill投稿</h2>

<%= form_with model: skill do |f| %>
  <%= f.label :タイトル %><br/>
  <%= f.text_field :title %>
  <br/><br/>
  <%= f.label :本文 %><br/>
  <%= f.text_area :body %><br/>
  <%= f.submit '投稿', class: 'btn btn-success' %>
<% end %>
</div>
