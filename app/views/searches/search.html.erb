<div class="container px-5 px-sm-0">
  <h2>検索結果</h2>
  <table class="table table-hover table-inverse">
    <thead>
      <tr>
        <th>名前</th>
        <th>タイトル</th>
        <th>本文</th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody> 
    <% if @results.any? %>
      <% @results.each do |result| %>
  
        <% if @model == "user" %>
          <td>
            <%= link_to result.name, user_path(result) %>
          </td>
        <% elsif @model == "skill" %>
          <td>
            <%= link_to result.title, skill_path(result) %> 
          </td>
        <% end %>
    
      <% end %>
    <% else %> 
      <p>該当する結果がありませんでした。</p> 
    <% end %>
  </div>
</div>